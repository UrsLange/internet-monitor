<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.internet-monitor.ping</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <!-- Replace __HOME__ with your home directory, e.g. /Users/yourname -->
        <string>__HOME__/internet-monitor/ping-monitor.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__HOME__/internet-monitor/data/ping-daemon.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/internet-monitor/data/ping-daemon.log</string>

    <key>WorkingDirectory</key>
    <string>__HOME__/internet-monitor</string>
</dict>
</plist>
